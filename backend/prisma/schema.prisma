// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// -------------------------------------------------------------
// 1. Admin Users (Authentication for Admin Dashboard)
// -------------------------------------------------------------
model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("SUPER_ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// -------------------------------------------------------------
// 2. Portfolio Projects (Managed through Web Admin Dashboard)
// -------------------------------------------------------------
model Project {
  id           String   @id @default(uuid())
  number       String   // e.g. "01", "02", "03"
  title        String
  description  String
  technologies String   // JSON stringified array e.g. '["React","Node.js"]'
  category     String   // e.g. "Full-Stack", "Web Application"
  github       String?
  demo         String?
  featured     Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// -------------------------------------------------------------
// 3. Contact Inquiries from Portfolio visitors
// -------------------------------------------------------------
model ContactMessage {
  id         String   @id @default(uuid())
  name       String
  email      String
  subject    String
  message    String
  status     String   @default("UNREAD") // Status: "UNREAD", "READ", "REPLIED", "ARCHIVED"
  adminNotes String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// -------------------------------------------------------------
// 4. Skills & Proficiencies (Dynamic Management)
// -------------------------------------------------------------
model Skill {
  id          String   @id @default(uuid())
  category    String   // e.g. "Frontend", "Backend", "Databases", "DevOps & Cloud"
  name        String
  proficiency Int      @default(85) // 0 - 100
  icon        String?  // optional tech icon identifier
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -------------------------------------------------------------
// 5. Site Configuration / Profile Settings
// -------------------------------------------------------------
model SiteConfig {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. "hero_status", "bio_summary", "resume_url"
  value     String
  updatedAt DateTime @updatedAt
}
