# Backend Environment Configuration
PORT=5001
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection String
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://postgres:postgres_secure_password@postgres:5432/portfolio_db?schema=public

# Secret key for JWT signing (use a strong random 64-char string in production)
JWT_SECRET=replace_with_strong_random_jwt_secret_key_in_production
